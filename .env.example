# =====================================================================================
# karatly-web: settings for `docker compose up` and `npm run dev`
# =====================================================================================
#
# Copy this file to .env in the same folder and uncomment only the lines you need.
# .env is ignored by git. Never commit it.

# ---- Ports on your computer (docker compose) -------------------------------------------
# WEB_PORT=3001        the app
# API_PORT=8091        the API directly (only reachable from this computer)

# ---- Where `npm run dev` forwards API calls ----------------------------------------------
# KARATLY_API_URL=http://localhost:8081

# ---- Time zone that decides what "today" is ------------------------------------------
# KARATLY_TIME_ZONE=Asia/Kolkata
